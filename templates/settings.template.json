{
  "$comment": "brain-kit hook wiring. Commit this so every session in the repo shares the same gates; personal overrides go in .claude/settings.local.json (gitignored). `agent-brain-kit setup` MERGES these hooks into an existing settings.json and never removes yours. The guard matcher includes PowerShell because the PowerShell tool runs commands too, through the same tool_input.command field.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder|test-writer|qa",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\"",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/brain-check.sh\"",
            "async": true
          }
        ]
      }
    ]
  }
}
